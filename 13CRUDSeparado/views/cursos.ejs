<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="../css/estilos.css">
</head>
<body>
    <main class="container">
        <table class = "table" border = "1">
            <thead>
                <tr>
                    <th>Nombte</th>
                    <th>Descripcion</th>
                    <th>Docentes</th>
                </tr>
            </thead>
            <%
                if(array.isArray(cursos) && cursos.length > 0) {
            %>

            <tbody>
                <tr>
                    <%
                    cursos.forEach(function(curso) {
                    %>
                    <td><%= curso.id %></td>
                    <td><%= curso.nombre || '' %></td>
                    <td><%= curso.descripcion || '' %></td>
                    <td><%= curso.docente || '' %></td>
                </tr>
                <% ]); %>
            </tbody>

        </table>
        <% } else { %>
            <div>No hay cursos disponibles en este momento,
                existe un error al cargarlos
            </div>
            <p><a href="../views/bienvenida.html">Volver a Bienvenida</a></p>
        <% } %>

    </main>
</body>
</html>